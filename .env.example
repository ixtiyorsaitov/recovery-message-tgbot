# Telegram API credentials from https://my.telegram.org
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Your personal bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (the bot will send alerts to you)
# Get it from @userinfobot or @RawDataBot on Telegram
BOT_OWNER_ID=your_user_id_here

# (Optional) Specific chat/group/channel ID for alerts
# If empty, uses BOT_OWNER_ID (sends to you directly)
LOG_CHAT_ID=

# (Optional) Existing session string for re-login
# Leave empty to generate a new one via: npm run session
SESSION_STRING=
